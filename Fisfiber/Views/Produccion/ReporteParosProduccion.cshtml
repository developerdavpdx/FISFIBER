
@{
    ViewBag.Title = "Paros Producción";
}

<link rel="stylesheet" href="~/Styles/Produccion/ParosProduccion.css">
<div class="pt-5 ps-2 pe-2">
    <div class="row g-3 mb-3">
        <div class="col-12">
            <button id="BtnExportExcel" class="btn btn-success mt-3">
                <i class="fas fa-file-excel me-2"></i>Exportar a Excel
            </button>
        </div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-3">
            <label>Fecha inicio</label>
            <input type="date" id="FiltroFechaInicio" class="form-control">
        </div>
        <div class="col-3">
            <label>Fecha fin</label>
            <input type="date" id="FiltroFechaFin" class="form-control">
        </div>
        <div class="col-3">
            <label>Línea</label>
            <input type="text" id="FiltroLinea" class="form-control">
        </div>
        <div class="col-3 d-flex align-items-end">
            <button class="btn btn-outline-secondary w-100" id="BtnFiltrarHistorico">
                <i class="fas fa-search me-2"></i>Filtrar
            </button>
        </div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-12 body-table">
            <table id="TblReporteParos" 
                   ParosHistoricos="@Url.Action("GetParosHistoricos","Produccion")" 
                   class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Fecha inicio</th>
                        <th>Fecha fin</th>
                        <th>Línea</th>
                        <th>Tipo Mantenimiento</th>
                        <th>Motivo</th>
                        <th>Solicitante</th>
                        <th>Usuario Realizó</th>
                        <th>Rubro</th>
                        <th>Observaciones</th>
                        <th>Estatus</th>
                        <th>Orden Trabajo</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>
<!-- SheetJS (XLSX) para exportar a Excel -->
@*<script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>*@
<script src="https://cdn.jsdelivr.net/npm/exceljs/dist/exceljs.min.js"></script>
<script src="~/Scripts/Produccion/ReportesParosProduccion.js?v=1.0.1"></script>
