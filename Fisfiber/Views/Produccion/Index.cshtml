<!-- MODAL CAMBIAR ESTATUS -->
<div class="modal fade" id="editEstatus" tabindex="-1" aria-labelledby="editEstatus" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header modalH" data-bs-theme="dark">
                <h5 class="modal-title" id="exampleModalLabel">Cambiar Estatus</h5>
                <button type="button" class="btn-close " data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3" style="width: 60%;">
                    <span class="input-group-text bg-pr" id="basic-addon3">NUEVO ESTATUS</span>
                    <select class="form-select form-select-sm">
                        <option selected value="1">INICIADA</option>
                        <option value="2">PAUSADA</option>
                        <option value="3">CANCELADA</option>
                        <option value="3">TERMINADA</option>
                    </select>
                </div>
                <label class="form-label">Comentario</label>
                <div class="input-group">
                    <textarea class="form-control" aria-label="pausa y cancelado requieren comentario..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-prcancel" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-prsuccess">Guardar cambios</button>
            </div>
        </div>
    </div>
</div>

