
@{
    ViewBag.Title = "Consulta Plan Producción";
}

<link rel="stylesheet" href="~/Styles/PlanProduccion/ConsultaPlanProduccion.css">
<link rel="stylesheet" href="~/Styles/PlanProduccion/PlanPro.css">
<link rel="stylesheet" href="~/Styles/Produccion/ParosProduccion.css">


<div class="pt-2 ms-3 me-4">
    <div class="row pt-1 ps-3 pe-3 pt-4">
        <div class="col-12 text-center">
            <h5>
                Planes de producción generados
            </h5>
        </div>
    </div>
    <div class="col-md-6 mb-4">
        <div class="form-check form-switch">
            <input class="form-check-input"
                   type="checkbox"
                   id="swichCapLinea" checked>
            <label class="form-check-label" for="swichCapLinea">
                Mostrar capacidades linea
            </label>
        </div>
    </div>
    <div class="col-md-6 col-auto">
        <h6 class="font-weight-bold">
            Lineas
        </h6>
        <form metodo="FiltroLineas" class="needs-validation" novalidate>
            <div class="row">
                <div id="NombreLineas" class="row lineas-container">
                    <div class="form-check lineas-check">
                        <input type="checkbox" class="form-check-input anycheck" id="178948">
                        <label class="form-check-label" for="178948">Check me out</label>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="row pt-1 ps-3 pe-3 pt-4">
        <div class="col-12 text-right">
            <a id="edicionPP" href="#">
                <p class="edicionPP hover-effect-8">
                    Configuración plan producción <i class="fa-solid fa-gear"></i>
                </p>
            </a>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 body-table">
            <table id="PlanProduccion"
                   action="@Url.Action("GetPlanesProduccion","PlanProduccion")"
                   details="@Url.Action("GetPlanesProduccionDetailsCCP","PlanProduccion")"
                   bitacora="@Url.Action("GetBitacoraPP","PlanProduccion")"
                   bitacoradetails="@Url.Action("GetBitacoraDetailsPP","PlanProduccion")"
                   update="@Url.Action("ActualizarOF","PlanProduccion")"
                   configuracion="@Url.Action("GetConfigxUsuarioPP","PlanProduccion")"
                   updateconfiguracion="@Url.Action("InsertaConfigxUsuarioPP","PlanProduccion")"
                   ParoMannto="@Url.Action("InsertaParoMannto","PlanProduccion")" 
                   class="table table-striped table-bordered table-fixed"
                   style="min-width: 800px !important;"
                   >
                <thead>
                    <tr>
                        <th>Folio</th>
                        <th>Linea</th>
                        @*<th>Cantidad Kilos</th>
                        <th>Artículo</th>
                        <th>Descripción Artículo</th>
                        <th>Generar</th>
                        <th>No Orden Fabricación</th>
                        <th>Estatus</th>
                        <th>Acciones</th>*@
                    </tr>
                </thead>
                <tbody>
                    <tr style="background-color:lightgray">
                        <td style="text-align:center" colspan="8">SIN DATOS</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="row pt-5">
        <div class="col-12">
            <div class="card bg-light mb-3">
                <div class="card-header">
                    <div id="PPHeader" class="d-none bg-white rounded box-shadow">
                        <div class="card">
                            <div class="card-body ReportHeaderv2">
                                <div class="row">
                                    <div class="col-6 text-start d-flex align-items-center justify-content-start">
                                        <img src="/Images/logoFisfiber.png" alt="" class="w-50">
                                    </div>
                                    <div class="col-6 text-end">
                                        <div class="row">
                                            <div class="col-12 text-start">
                                                <div class="TitleReportContainer">
                                                    <span class="ps-2">
                                                        FECHA DE LIBERACIÓN: <span id="">@ViewBag.FechaLib</span>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-6 text-start">
                                                <div class="TitleReportContainer">
                                                    <span class="ps-2">
                                                        @ViewBag.CodeISO
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="col-6 text-start">
                                                <div class="TitleReportContainer text-right">
                                                    <span class="pe-2">
                                                        REVISION: <span id="">@ViewBag.Revision</span>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-9 text-start">
                                                <div class="TitleReportContainer">
                                                    <span class="ps-2">
                                                        FECHA DE REVISIÓN: <span id="">@ViewBag.FechaRev</span>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="col-3 text-start">
                                                <div class="TitleReportContainer text-right">
                                                    <span class="pe-2">
                                                        NIVEL @ViewBag.Nivel
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-6 text-start">
                                                <div class="TitleReportContainer">
                                                    <span class="ps-2">
                                                        FOLIO: <span id="folio"></span>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="col-6 text-start">
                                                <div class="TitleReportContainer text-right">
                                                    <span class="pe-2">
                                                        FECHA: <span id="fecha-documento"></span>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h5 id="PPHeaderTitle" class="text-center">
                        Detalle de plan de producción <strong id="folioseleccionado"></strong>
                    </h5>
                </div>
                <div id="reportbyline" class="card-body pt-2">
                    <h5 class="card-title">!Ningún plan seleccionado!</h5>
                    <p class="card-text">Aquí podrás visualizar el detalle de el plan de producción seleccionado.</p>
                </div>
            </div>
        </div>
    </div>
    <div class="row pb-4 pt-2 pe-3">
        <div class="col-12 d-flex justify-content-end">
            <a href="#" id="actualizar" restart="false" class="d-none btn mb-2 mb-md-0 btn-outline next">Actualizar</a>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="Bitacora" tabindex="-1" aria-labelledby="Bitacora" aria-hidden="true" data-bs-backdrop="static" @*data-bs-keyboard="false"*@>
        <div class="modal-dialog modal-dialog-centered modal-lg modal100">
            <div class="modal-content">
                <div class="modal-header" style="display:block !important">
                    <h5 class="modal-title" id="HeaderTitle">Bitácora de plan de producción <strong id="folioPP"></strong></h5>
                    <span>*Aqui se mostrará el historial de versiones anteriores del plan, la ultima versión se muestra en la página principal en la parte inferiór al dar click en un folio*</span>
                    @*<i role="button" class="fa-solid fa-xmark" data-bs-dismiss="modal" aria-label="Close"></i>*@
                </div>
                <form metodo="" class="pt-1 ps-3 pe-3 needs-validation" novalidate>
                    <div class="modal-body text-center">
                        <div class="row">
                            <div class="col-md-12 body-table">
                                <table id="BitacoraPP" class="table table-striped table-bordered table-fixed">
                                    <thead>
                                        <tr>
                                            <th width="150">Folio</th>
                                            <th>Revisión</th>
                                            <th>Descripción</th>
                                            <th width="300">Usuario</th>
                                            <th width="250">Fecha</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="background-color:lightgray">
                                            <td style="text-align:center" colspan="5">SIN DATOS</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer mt-3">
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="BitacoraDetalle" tabindex="-1" aria-labelledby="Bitacora" aria-hidden="true" data-bs-backdrop="static" @*data-bs-keyboard="false"*@>
        <div class="modal-dialog modal-dialog-centered modal-lg modal100">
            <div class="modal-content">
                <div class="modal-header" style="display:block !important">
                    <div class="d-flex justify-content-between align-items-center">
                        <div><h6 class="modal-title" id="HeaderTitle">Bitácora de plan de producción <strong id="folioRevision"></strong></h6></div>
                        <div><h6 class="modal-title"> Revisión <strong id="Revision"></strong></h6></div>
                        <div><h6 class="modal-title"> Fecha <strong id="FechaRevision"></strong></h6></div>
                    </div>
                </div>
                <form metodo="" class="pt-1 ps-3 pe-3 needs-validation" novalidate>
                    <div class="modal-body text-center">
                        <div class="row pb-2">
                            <div class="col-md-12 d-flex justify-content-end">
                                <button type="button" id="DescargarBitacora" class="btn btn-outline-secondary">Descargar Excel</button>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="row m-0 pb-4">
                                    <div class="col-md-12 p-0 body-table">
                                        <table id="BitacoraDetailsList" class="table table-striped table-bordered" style="table-layout:fixed">
                                            <thead>
                                                <tr>
                                                    <th width="240">Línea</th>
                                                    <th width="200">Comentarios Extras</th>
                                                    <th width="200">Prioridad</th>
                                                    <th width="200">Ubicación Propuesta</th>
                                                    <th width="200">Hora Propuesta</th>
                                                    <th width="200">Ubicación Final</th>
                                                    <th width="200">Rollos</th>
                                                    <th width="200">Piezas Producidas</th>
                                                    <th width="200">Pedido</th>
                                                    <th width="200">Codigo Cliente</th>
                                                    <th width="200">Solicitado</th>
                                                    <th width="200">Núm. Artículo</th>
                                                    <th width="250">Descripción Artículo</th>
                                                    <th width="200">Almacén</th>
                                                    <th width="200">Metros Rollo</th>
                                                    @*<th width="200">Especificación</th>*@
                                                    <th width="200">Hora Inicio</th>
                                                    <th width="200">Hora Final</th>
                                                    <th width="200">Tiempo Producción</th>
                                                    <th width="200">Cantidad Metros</th>
                                                    <th width="200">Comentarios</th>
                                                    <th width="200">Fecha Contabilización</th>
                                                    <th width="200">Fecha Fabricación</th>
                                                    <th width="200">Fecha Entrega</th>
                                                    <th width="200">Cliente</th>
                                                    <th width="200">Cantidad Kilos</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer mt-3">
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="ConfiguracionPP" tabindex="-1" aria-labelledby="Bitacora" aria-hidden="true" data-bs-backdrop="static" @*data-bs-keyboard="false"*@>
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content-transparent">
                <div class="modal-header-transparent" style="display:block !important">

                </div>

                <div class="modal-body text-center">
                    <form metodo="" class="pt-1 ps-3 pe-3 needs-validation" novalidate>
                        <div class="row">
                            <div class="col-12">
                                <div class="container">
                                    <div class="row pt-1 m-auto">
                                        <div class="col-md-12 col-lg-12 pb-3">
                                            <div class="card card-custom bg-white border-white border-0" style="height: 550px">
                                                <div class="card-custom-img" style="background-image: url(http://res.cloudinary.com/d3/image/upload/c_scale,q_auto:good,w_1110/trianglify-v1-cs85g_cc5d2i.jpg);">
                                                    <div class="card-header text-right" style="border:none !important">
                                                        <span class="text-white font-weight-bold fs-6">* Configura las columnas visibles para el plan de producción *</span>
                                                        <div class="pb-3 pt-2 ps-3 form-check">
                                                            <input type="checkbox" class="form-check-input anycheck" id="selectAll">
                                                            <label class="form-check-label text-white font-weight-bold" for="selectAll">Seleccionar todas</label>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-custom-avatar">
                                                    <img class="img-fluid" src="~/Images/FFISA.png" alt="Avatar">
                                                </div>
                                                <div class="card-body d-flex justify-content-start flex-column" id="configuracionPPContainer" style="overflow-y: auto">

                                                </div>
                                                <div class="card-footer" style="background: inherit; border-color: inherit;text-align:end">
                                                    <a href="#" class="btn btn-outline-secondary" id="GuardaConfigPP">Guardar</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal moderno para registrar nuevo paro -->
    <div class="modal fade" id="ParoModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-sm">
                <div class="modal-header bg-light text-white">
                    <h5 class="modal-title text-dark" id="modalParoTitulo">
                        <i class="fas fa-tools me-2"></i>Registrar Nuevo Paro
                    </h5>
                </div>
                <form id="FormParo" class="needs-validationcustom" novalidate>
                    <div class="modal-body">
                        <input type="hidden" id="equipoId">
                        <div class="row g-3">
                            <!-- Línea -->
                            <div class="col-6">
                                <label for="Linea" class="form-label fw-semibold">Línea</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-industry"></i></span>
                                    <input type="text" class="form-control" id="Linea" readonly required>
                                </div>
                            </div>

                            <!-- Fecha -->
                            <div class="col-6">
                                <label for="FechaParo" class="form-label fw-semibold">Fecha</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                    <input type="text" class="form-control" id="FechaParo" readonly required>
                                </div>
                            </div>

                            <!-- Motivo Reparación -->
                            <div class="col-12">
                                <label for="MotivoReparacion" class="form-label fw-semibold">Motivo Reparación</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-tools"></i></span>
                                    <textarea class="form-control TextAreaReadOnly" id="MotivoReparacion" rows="2" required></textarea>
                                    <div class="invalid-feedback">
                                        Escriba el motivo del paro.
                                    </div>
                                </div>
                            </div>

                            <!-- Solicitante -->
                            <div class="col-12">
                                <label for="Solicitante" class="form-label fw-semibold">Solicitante</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                                    <input type="text" class="form-control" id="Solicitante" required>
                                    <div class="invalid-feedback">
                                        Escriba el solicitante.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer justify-content-end">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" title="Cancelar">
                            <i class="fas fa-times-circle me-1"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-outline-secondary" id="btnGuardarEquipo" title="Guardar">
                            <i class="fas fa-save me-1"></i>Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
@*<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.16.9/xlsx.full.min.js"></script>*@
<script src="~/Scripts/Produccion/ConsultaPlanProduccion.js?v=1.4.4"></script>