                        <th class="fw-medium">F. Revisión</th>
                        <th class="fw-medium">No. Rev</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    <tr>
                        <td>
                            <div class="d-flex gap-1 justify-content-center">
                                <button class="btn btn-light btn-lg py-0 px-2 border edit-line" title="Editar"
                                        data-bs-toggle="modal" data-bs-target="#modalAjusTempRecetas">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>
                                <button class="btn btn-light btn-lg py-0 px-2 border trash-line" title="Eliminar"
                                        data-bs-toggle="modal" data-bs-target="#modalEliminaRecetas">
                                    <i class="bi bi-trash3-fill"></i>
                                </button>
                            </div>
                        </td>
                        <td class="fw-medium">Receta Std-01</td>
                        <td><span class="badge bg-secondary">30%</span></td>
                        <td><span class="badge bg-secondary">25%</span></td>
                        <td><span class="badge bg-secondary">25%</span></td>
                        <td><span class="badge bg-secondary">20%</span></td>
                        <td><span class="badge bg-resinas-table">30%</span></td>
                        <td><span class="text-muted fst-italic">Estándar</span></td>
                        <td><span class="badge bg-light text-dark border">2025-01-15</span></td>
                        <td><span class="badge bg-light text-dark border">2025-03-01</span></td>
