<!-- ══════════════════════════════════════════════════
     Modal: Control Versionado
════════════════════════════════════════════════════ -->
<div class="modal fade" id="modalControlVersionado" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-pr text-white">
                <h5 class="modal-title">
                    <i class="bi bi-plus-circle me-2"></i>Control Versionado
                </h5>
                <button type="button" class="btn btn-link text-white p-0" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="row g-4 mb-3">
                    <div class="d-flex flex-column align-items-end gap-3">
                        <!-- Botón actualizar -->
                        <button type="button"
                                id="btnActualizarEvidencia"
                                class="d-flex align-items-center gap-2 btn-evidencia">
                            <i class="bi bi-arrow-repeat fs-6"></i>
                            Adjuntar versionado
                        </button>
                        <input type="file" id="inputEvidencia" accept="image/*" class="d-none">

                    </div>
                    <!-- Imagen grande -->
                    <div class="d-flex flex-column align-items-end gap-3">
                        <div class="content-evidencia">
                            <img id="imgEvidencia" class="img-default" src="~/Images/load-files.png" alt="Evidencia" />
                        </div>
                       
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-prcancel" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="btnGuardarVersionado">Aceptar</button>
                </div>
            </div><!-- /.modal-body -->
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /#modalCreaRecetas -->
<!-- ══════════════════════════════════════════════════
     Modal: Crear Receta
════════════════════════════════════════════════════ -->
<div class="modal fade" id="modalCreaRecetas" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-pr text-white">
                <h5 class="modal-title">
                    <i class="bi bi-plus-circle me-2"></i>Crear Receta - Mezcla Fibras
                </h5>
                <button type="button" class="btn btn-link text-white p-0" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="row g-4 mb-3">
                    <!-- IZQUIERDA -->
                    <div class="col-12 col-lg-5">
                        <!-- INFORMACION GENERAL -->
                        <div class="mb-4">
                            <strong class="d-block mb-3">
                                <i class="bi bi-info-square icons-forms-sections"></i> Información General
                            </strong>
                            <div class="mb-3">
                                <label class="form-label">Nombre de Receta<span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm">
                            </div>
                        </div>

                        <!-- OBSERVACIONES -->
                        <div class="mb-4">
                            <label class="form-label fw-medium">Observaciones</label>
                            <textarea class="form-control" rows="5"></textarea>
                        </div>

                        <!-- RESINAS -->
                        <div class="card border-0 bg-light">
                            <div class="card-body">
                                <strong class="d-block mb-3">
                                    <i class="bi bi-droplet icons-forms-sections"></i> Configuración de Resinas
                                </strong>
                                <div class="row g-3">

                                    <div class="col-12">
                                        <label class="form-label">Resina Virgen (%)</label>
                                        <input type="number" class="form-control form-control-sm">
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label">Resina Recuperada (%)</label>
                                        <input type="number" class="form-control form-control-sm">
                                    </div>

                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- DERECHA -->
                    <div class="col-12 col-lg-7">
                        <strong class="d-block mb-3">
                            <i class="bi bi-box-seam icons-forms-sections"></i> Configuración de Cargadoras
                        </strong>
                        <div class="row g-3">
                            <!-- CARGADORA -->
                            <div class="col-12">
                                <div class="border rounded p-2">
                                    <label class="form-label fw-medium mb-2">
                                        Cargadora 1
                                    </label>
                                    <input type="text" class="form-control form-control-sm mb-2" placeholder="Denier" />
                                    <input type="text" class="form-control form-control-sm" placeholder="Porcentaje %" />
                                </div>
                            </div>

                            <!-- CARGADORA -->
                            <div class="col-12">
                                <div class="border rounded p-2">
                                    <label class="form-label fw-medium mb-2">
                                        Cargadora 2
                                    </label>
                                    <input type="text" class="form-control form-control-sm mb-2" placeholder="Denier" />
                                    <input type="text" class="form-control form-control-sm" placeholder="Porcentaje %" />
                                </div>
                            </div>

                            <!-- CARGADORA -->
                            <div class="col-12">
                                <div class="border rounded p-2">
                                    <label class="form-label fw-medium mb-2">
                                        Cargadora 3
                                    </label>
                                    <input type="text" class="form-control form-control-sm mb-2" placeholder="Denier" />
                                    <input type="text" class="form-control form-control-sm" placeholder="Porcentaje %" />
                                </div>
                            </div>

                            <!-- CARGADORA -->
                            <div class="col-12">
                                <div class="border rounded p-2">
                                    <label class="form-label fw-medium mb-2">
                                        Cargadora 4
                                    </label>
                                    <input type="text" class="form-control form-control-sm mb-2" placeholder="Denier" />
                                    <input type="text" class="form-control form-control-sm" placeholder="Porcentaje %" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-prcancel" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="btnGuardarReceta">Aceptar</button>
                </div>
            </div><!-- /.modal-body -->
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /#modalCreaRecetas -->

