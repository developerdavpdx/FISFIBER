@{
    ViewBag.Title = "Gestión de Recetas";
}

<link rel="stylesheet" href="~/Styles/Produccion/GestionRecetas.css" />

<!-- Navbar -->
<nav class="navbar px-4 py-2 barra-sup">
    <span class="navbar-brand mb-0 text-white h6">Mezcla de Fibras</span>
    <div class="d-flex align-items-center gap-2 text-white-50">
        <small>Supervisor de Producción</small>
        <div class="avatar">SP</div>
    </div>
</nav>

<div class="ps-4 pe-4 pb-4">

    <div class="container-fluid px-4 py-4">
        <!-- Header + toolbar -->
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
            <div>
                <h1 class="h4 fw-semibold text-dark mb-1">Gestión de Recetas</h1>
                <p class="text-secondary small mb-0">Módulo de mezcla de fibras y resinas</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <input type="text" class="form-control form-control-sm" placeholder="Filtrar por línea..." style="width:200px" />
                <button class="btn btn-CrearReceta btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#modalCreaRecetas">
                    <i class="bi bi-plus-lg me-1"></i>Crear Receta
                </button>
            </div>
        </div>
    </div>

    <!-- ── Tabla: Líneas de Producción ── -->
    <p class="fw-semibold text-dark mb-2">Líneas de Producción</p>
    <div class="table-responsive rounded mb-4 shadow-lg">
        <table class="tabla-lineas tabla-custom table-hover table-striped align-middle mb-0">
            <thead>
                <tr data-linea="1">
                    <th class="fw-medium">Línea</th>
                    <th class="fw-medium">No. Recetas</th>
                    <th class="fw-medium">
                        Control Versionado
                    </th>
                </tr>
            </thead>
            <tbody class="bg-white">
                <tr class="fila-linea" data-linea="2">
                    <td>Línea 1 – Producción A</td>
                    <td>5</td>
                    <td class="celda-evidencia text-center">
                        <button class="btn btn-light btn-sm btn-outline-danger" title="Actualizar versionado" data-bs-toggle="modal" data-bs-target="#modalControlVersionado">
                            <i class="bi bi-paperclip"></i>
                        </button>
                    </td>
                </tr>
                <tr class="fila-linea" data-linea="3">
                    <td>Línea 2 – Producción B</td>
                    <td>3</td>
                    <td class="celda-evidencia text-center">
                        <button class="btn btn-light btn-sm btn-outline-danger" title="Actualizar versionado" data-bs-toggle="modal" data-bs-target="#modalControlVersionado">
                            <i class="bi bi-paperclip"></i>
                        </button>
                    </td>
                </tr>
                <tr class="fila-linea" data-linea="4">
                    <td>Línea 3 – Producción C</td>
                    <td>7</td>
                    <td class="celda-evidencia text-center">
                        <button class="btn btn-light btn-sm btn-outline-danger" title="Actualizar versionado" data-bs-toggle="modal" data-bs-target="#modalControlVersionado">
                            <i class="bi bi-paperclip"></i>
                        </button>
                    </td>
                </tr>

            </tbody>
        </table>
    </div>

    <div id="seccionRecetas" style="display:none;">

        <!-- ── Tabla: Recetas de Fibras ── -->
        <p class="fw-semibold text-dark mb-2">Recetas de Fibras – Línea 1</p>
        <div class="table-responsive rounded mb-4 shadow-sm">
            <table class="table tabla-custom table-hover table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th class="fw-medium">Acciones</th>
                        <th class="fw-medium">Nombre Receta</th>
