
@{
    ViewBag.Title = "Paros Producción";
}

<link rel="stylesheet" href="~/Styles/Produccion/ParosProduccion.css">
<div class="pt-5 ps-2 pe-2">
    <div class="row m-0 pt-2 pb-3">
        <div class="col-12 col-xl-12 mb-4 mb-lg-0 text-start">
            <!-- Botón para agregar nuevo equipo (icono + texto) -->
            <div class="mt-3">
                <a href="@Url.Action("ReporteParosProduccion","Produccion")" id="AgregarEquipo" class="btn btn-outline-secondary" title="Agregar Nuevo Equipo">
                    <i class="fs-5 fa-solid fa-book"></i> Reportes
                </a>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 body-table">
            <table id="Tblparosproduccion"  
                   ParosProduccion="@Url.Action("GetParosProduccion","Produccion")" 
                   ActualizarParo="@Url.Action("ActualizarParo","Produccion")" 
                   GetOpRubro="@Url.Action("GetOpRubro","Produccion")" 
                   GetOpTipoMant="@Url.Action("GetOpTipoMant","Produccion")" 
                   class="table table-striped table-fixed dataTable" style="width:100%">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Línea</th>
                        <th>Fecha</th>
                        <th>Motivo</th>
                        <th>Solicitante</th>
                        <th>Estatus</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal moderno para registrar nuevo paro -->
<div class="modal fade" id="ParoModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-sm">
            <div class="modal-header bg-light text-white">
                <h5 class="modal-title text-dark" id="modalParoTitulo">
                    <i class="fas fa-tools me-2"></i>Registrar Nuevo Paro
                </h5>
            </div>
            <form id="FormParo" class="needs-validationcustom" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="equipoId">
                    <div class="row g-3">

                        <!-- Máquina/Línea -->
                        <div class="col-md-6">
                            <label for="Linea" class="form-label fw-semibold">Máquina / Línea</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-industry"></i></span>
                                <input type="text" class="form-control" id="Linea" readonly required>
                            </div>
                        </div>

                        <!-- Fecha fin paro -->
                        <div class="col-md-6">
                            <label for="FechaParo" class="form-label fw-semibold">Fecha y Hora de Fin del Paro</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                <input type="text" class="form-control" id="FechaParo" readonly required>
                            </div>
                        </div>

                        <!-- Usuario Realizó -->
                        <div class="col-md-6">
                            <label for="UsuarioRealizo" class="form-label fw-semibold">Quien realizó el mantenimiento</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user-cog"></i></span>
                                <input type="text" class="form-control" id="UsuarioRealizo" required>
                            </div>
                        </div>

                        <!-- Tipo Mantenimiento -->
                        <div class="col-md-6">
                            <label for="TipoMantenimiento" class="form-label fw-semibold">Tipo de Mantenimiento</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-wrench"></i></span>
                                <select class="form-select" id="TipoMantenimiento" required>
                                    <option value="">Seleccione...</option>
                                    <option value="Preventivo">Mantenimiento Preventivo</option>
                                    <option value="Correctivo">Mantenimiento Correctivo</option>
                                    <option value="CorrectivoPlaneado">Mantenimiento Correctivo Planeado sin afectar Producción</option>
                                </select>
                                <div class="invalid-feedback">
                                    Seleccione el tipo de mantenimiento.
                                </div>
                            </div>
                        </div>

                        <!-- Rubro -->
                        <div class="col-md-6">
                            <label for="Rubro" class="form-label fw-semibold">Rubro</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-cogs"></i></span>
                                <select class="form-select" id="Rubro" required>
                                    <option value="">Seleccione...</option>
                                    <option value="Electrica">Eléctrica</option>
                                    <option value="Mecanica">Mecánica</option>
                                    <option value="Programada">Programada</option>
                                    <option value="Producción">Producción</option>
                                    <option value="Calidad">Calidad</option>
                                    <option value="Materia prima">Materia prima</option>
                                    <option value="Planeación">Planeación</option>
                                </select>
                                <div class="invalid-feedback">
                                    Seleccione el rubro.
                                </div>
                            </div>
                        </div>

                        <!-- Orden de trabajo -->
                        <div class="col-md-6">
                            <label for="OrdenTrabajo" class="form-label fw-semibold">Orden de Trabajo</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-clipboard-list"></i></span>
                                <input type="text" class="form-control" id="OrdenTrabajo" required>
                                <div class="invalid-feedback">
                                    Ingrese la orden de trabajo.
                                </div>
                            </div>
                        </div>

                        <!-- Observaciones -->
                        <div class="col-12">
                            <label for="Observaciones" class="form-label fw-semibold">Observaciones</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-comment-dots"></i></span>
                                <textarea style="resize:none" class="form-control" id="Observaciones" rows="2" required></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer justify-content-end">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" title="Cancelar">
                        <i class="fas fa-times-circle me-1"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-outline-primary" id="btnGuardarEquipo" title="Guardar">
                        <i class="fas fa-save me-1"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/Scripts/Produccion/ParosProduccion.js?v=1.0.3"></script>

