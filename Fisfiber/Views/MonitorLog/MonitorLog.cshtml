
@{
    ViewBag.Title = "Monitor Logistica";
}

<link rel="stylesheet" href="~/Styles/MonitorLog/monitorLog.css">
<link rel="stylesheet" href="~/Styles/TableScrollH.css">




<div class="pt-3 ps-3 pe-4"
     id="mainML"
     PlanEmb="@Url.Action("GetPlanEmbDetailsByFolio","MonitorLog")"
     EstatusCarga="@Url.Action("GetEstatusCargaAut","MonitorLog")"
     UpdateEstatusCarga="@Url.Action("UpdateEstatus","MonitorLog")"
     GetFacturas="@Url.Action("GetFacturasPedidosByFolio","MonitorLog")"
     PlanProduccionDet="@Url.Action("GetPlanesProduccionDetails","PlanEmb")"
     PedidosInfo="@Url.Action("GetPedidosInPP","PlanEmb")"
     OVDetails="@Url.Action("GetOrdenesVentaDetails","Global")">

    <div class="row pt-1 ps-3 pe-3 pt-4">
        <div class="col-12 text-center">
            <h5>
                PLANES DE EMBARQUES
            </h5>
        </div>
    </div>

    <div class="row pt-3">
        <div class="col-md-12 body-table">
            <table id="PlanesEmbMasc"
                   action="@Url.Action("GetPlanesEmbarques","PlanEmb")"
                   class="table table-striped table-fixed">
                <thead>
                    <tr>
                        <th>Folio</th>
                        <th>FechaCreacion</th>
                        <th>TotalPedidos</th>
                        <th>TotalAutorizados</th>
                        <th>TotalNoAutorizados</th>
                        <th>TotalClientes</th>
                        <th>TotalArticulos</th>
                        <th>TotalConCita</th>
                        <th>TotalEntregaParcial</th>
                        <th>TotalPiezasEntrega</th>
                    </tr>
                </thead>
                <tbody>
                    <tr style="background-color:lightgray">
                        <td style="text-align:center" colspan="8">SIN DATOS</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>


    <div class="row pt-5 px-2 monitorVacio">
        <div class="col-12">
            <div class="card bg-light mb-3">
                <div class="card-header">
                    <h5 class="text-center">
                        Detalle de monitor del plan
                    </h5>
                </div>


                <div class="card-body pt-2">

                    <h5 class="card-title">!Ningún plan seleccionado!</h5>
                    <p class="card-text">Aquí podrás visualizar el detalle del plan de embarques seleccionado.</p>
                </div>

            </div>
        </div>
    </div>


    <div class="row mx-2 detalleMonitor d-none">

        <div class="filter-section">

            <div id="PPHeader" class="bg-black rounded box-shadow">
                <div class="card bg-black" style="color:white;">
                    <div class="card-body ReportHeaderv2">
                        <div class="row">
                            <div class="col-6 text-start d-flex align-items-center justify-content-start">
                                <img src="/Images/logoFisfiber.png" alt="" class="w-50">
                            </div>
                            <div class="col-6 text-end">

                                <div class="row EditRow">

                                    <div class="col-6">
                                        <div class="input-group input-group-sm  editAdmin mb-2">
                                            <span class="input-group-text">Fecha Liberación:</span>
                                            <input type="date"
                                                   id="FL"
                                                   value="@Convert.ToDateTime(ViewBag.FechaLib).ToString("yyyy-MM-dd")"
                                                   class="form-control"
                                                   style="height:34.2px"
                                                   aria-label="Sizing example input"
                                                   aria-describedby="inputGroup-sizing-sm">
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="input-group input-group-sm editAdmin mb-2">
                                            <span class="input-group-text">Code:</span>
                                            <input type="text"
                                                   id="Code"
                                                   value="@ViewBag.CodeIso"
                                                   class="form-control"
                                                   style="height:34.2px"
                                                   aria-label="Sizing example input"
                                                   aria-describedby="inputGroup-sizing-sm">
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="input-group input-group input-group-sm editAdmin mb-2">
                                            <span class="input-group-text">Fecha Revisión:</span>
                                            <input type="date"
                                                   id="FR"
                                                   value="@Convert.ToDateTime(ViewBag.FechaRev).ToString("yyyy-MM-dd")"
                                                   class="form-control"
                                                   style="height:34.2px"
                                                   aria-label="Sizing example input"
                                                   aria-describedby="inputGroup-sizing-sm">
                                        </div>
                                    </div>

                                    <div class="col-3">
                                        <div class="input-group input-group-sm editAdmin mb-2">
                                            <span class="input-group-text">Nivel:</span>
                                            <input type="number"
                                                   id="Nivel"
                                                   value="@ViewBag.Nivel"
                                                   class="form-control"
                                                   style="height:34.2px"
                                                   aria-label="Sizing example input"
                                                   aria-describedby="inputGroup-sizing-sm">
                                        </div>
                                    </div>


                                    <div class="col-3">
                                        <div class="input-group input-group-sm editAdmin mb-2">
                                            <span class="input-group-text">Revisión:</span>
                                            <input type="number"
                                                   id="Revision"
                                                   value="@ViewBag.Revision"
                                                   class="form-control"
                                                   style="height: 34.2px"
                                                   aria-label="Sizing example input"
                                                   aria-describedby="inputGroup-sizing-sm" />
                                        </div>
                                    </div>

                                    <div class="col-3 text-start">
                                        <button type="button"
                                                class="btn btn-primary btn-sm btnSave ">
                                            Guardar
                                        </button>
                                    </div>

                                </div>

                                <div class="row headRow">
                                    <div class="col-8 text-start">
                                        <div class="TitleReportContainer">
                                            <span class="ps-2 ISO">
                                                FECHA DE LIBERACIÓN:
                                                <span id="fecha-liberacion">@ViewBag.FechaLib</span>
                                            </span>
                                        </div>

                                    </div>
                                    <div class="col-4 btnEditHead">
                                        <i class=" editHead bi bi-pencil-square pointer-event"></i>
                                    </div>

                                </div>
                                <div class="row mt-2 headRow">
                                    <div class="col-6 text-start">
                                        <div class="TitleReportContainer">
                                            <span class="ps-2 ISO">
                                                @ViewBag.CodeISO
                                            </span>

                                        </div>
                                    </div>
                                    <div class="col-6 text-start">
                                        <div class="TitleReportContainer text-right">
                                            <span class="pe-2">
                                                REVISION: <span id="">  @ViewBag.Revision</span>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mt-2 headRow">
                                    <div class="col-9 text-start">
                                        <div class="TitleReportContainer">
                                            <span class="ps-2 ISO">
                                                FECHA DE REVISIÓN: <span id="fecha-revisionPv">@ViewBag.FechaRev</span>
                                            </span>

                                        </div>
                                    </div>
                                    <div class="col-3 text-start">
                                        <div class="TitleReportContainer text-right">
                                            <span class="pe-2 ISO">
                                                NIVEL @ViewBag.Nivel
                                            </span>

                                        </div>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-6 text-start">
                                        <div class="TitleReportContainer">
                                            <span class="ps-2">
                                                FOLIO: <span id="folioPE"></span>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-6 text-start">
                                        <div class="TitleReportContainer text-right">
                                            <span class="pe-2">
                                                FECHA: <span id="fecha-documentoPE"></span>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="row justify-content-between">
                <div class="col-md-2">
                    <h2 id="textLocal"> </h2>
                </div>
                <div class="col-md-5">
                    <h2 id="textViaje"> </h2>
                </div>

                <div class="col-md-2">
                    <div class="input-group">
                        <label class="input-group-text" for="selectLocal">Local</label>
                        <select class="form-select"
                                id="selectLocal">
                            <option value="" selected>Todos...</option>
                            <option value="1">One</option>
                            <option value="2">Two</option>
                            <option value="3">Three</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="input-group">
                        <label class="input-group-text" for="selectLocal">Num. Viaje</label>
                        <select class="form-select"
                                id="selectViaje">
                            <option value="" selected>Todos...</option>
                            <option value="1">One</option>
                            <option value="2">Two</option>
                            <option value="3">Three</option>
                        </select>
                    </div>
                </div>

            </div>
        </div>

        <h4 class="section-title position-relative">
            Cargas en Curso
            <span 
                  id="estadoConexion" 
                  class="badge bg-success position-absolute"
                  style="right:0;"
                  >Conectado</span>
        </h4>

        <div class="card">
            <div class="card-header-monitor d-flex justify-content-between align-items-center">
                <span>Registros de Cargas en Progreso</span>
                <span class="badge bg-light text-dark" id="NumRegCargaCurso">2 registros</span>
            </div>
            <div class="card-body p-0 ">
                <div class="table-responsive table-scroll" id="containerCargasCurso">
                    <table id="CargasCurso" class="table table-hover table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Local</th>
                                <th>Unidad</th>
                                <th>Operador</th>
                                <th>N° Piezas</th>
                                <th>Producto</th>
                                <th>Cliente</th>
                                <th width="180">Estatus</th>
                                <th width="200">Avance Carga</th>
                                <th>Pedido</th>
                                <th>N° Entrega</th>
                                <th>StockSAP</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="background-color:lightgray">
                                <td style="text-align:center" colspan="8">SIN DATOS</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <h4 class="section-title">Cargas Terminadas</h4>

        <div class="card">
            <div class="card-header-monitor d-flex justify-content-between align-items-center">
                <span>Registros de Cargas Completadas</span>
                <span class="badge bg-light text-dark" id="NumRegCargaTerm">1 registro</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive table-scroll">
                    <table id="CargasTerminadas" class="table table-hover table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Unidad</th>
                                <th>Operador</th>
                                <th>N° Piezas</th>
                                <th>Cliente</th>
                                <th>Estatus</th>
                                <th>Pedido</th>
                                <th>Hora Factura</th>
                                <th># Factura / Remision</th>
                                <th>Hora Carta Porte</th>
                                <th>Hora Certificado Calidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="background-color:lightgray">
                                <td style="text-align:center" colspan="8">SIN DATOS</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>


    <!-- Modal mostrar plan produccion -->
    <div class="modal fade nodoLog" id="modalPlanPro"
         tabindex="-1" aria-labelledby="Bitacora" aria-hidden="true"
         data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-xl modal100">
            <div class="modal-content">
                <div class="modal-header" style="display:block !important">
                    <h5 class="modal-title">
                        Plan Producción Folio:
                        <span id="folioPlanPro"></span>
                        <strong></strong>
                        <button id="closePlanPro" type="button"
                                class="close" data-dismiss="modal" aria-label="Close">
                            <span id="" restart="true"
                                  class="btn mb-2 mb-md-0 btn-outline-danger next">
                                Cancelar
                            </span>
                        </button>
                    </h5>

                </div>
                <div class="modal-body text-center">
                    <div class="row body-table table-scroll">
                        <table id="PlanProduccionML"
                               class="table table-preview table-striped m-0 tableReport"
                               style="table-layout: fixed;">
                            <thead>
                                <tr>
                                    <th>Folio</th>
                                    <th>Linea</th>
                                    <th>Fecha Creación</th>
                                    <th>Cantidad Kilos</th>
                                    <th>Artículo</th>
                                    <th>Descripción Artículo</th>
                                    <th>Generar</th>
                                    <th>No Orden Fabricación</th>
                                    <th>Estatus</th>
                                    <th>Bitácora</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="background-color:lightgray">
                                    <td style="text-align:center" colspan="8">SIN DATOS</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer mt-3">

                </div>
            </div>
        </div>
    </div>



</div>
<script src="~/Scripts/MonitorLog/MonitorLog.js?v=1.3.7"></script>
