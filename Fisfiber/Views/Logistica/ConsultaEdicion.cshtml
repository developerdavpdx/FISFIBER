
@{
    ViewBag.Title = "Consulta Del Monitor de Logística";
}
<link rel="stylesheet" href="~/Styles/PlanProduccion/ConsultaPlanProduccion.css">
<link rel="stylesheet" href="~/Styles/PlanProduccion/PlanPro.css">

<div class="pt-2 ms-3 me-4">
    <div class="row pt-1 ps-3 pe-3 pt-4">
        <div class="col-12 text-center">
            <h5>
                Monitores generados
            </h5>
        </div>
    </div>
    <div class="row pt-1 ps-3 pe-3 pt-4">
        <div class="col-12 text-right">
            <a id="edicionML" href="#">
                <p class="edicionML hover-effect-8">
                    Configuración monitor logística <i class="fa-solid fa-gear"></i>
                </p>
            </a>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 body-table">
            <table id="MonitorLogistica"
                   action="@Url.Action("GetMonitoresLogistica","Logistica")"
                   details="@Url.Action("GetMonitorLogisticaDetails","Logistica")"
                   bitacora="@Url.Action("GetBitacoraPP","PlanProduccion")"
                   bitacoradetails="@Url.Action("GetBitacoraDetailsPP","PlanProduccion")"
                   update="@Url.Action("UpdateMonitor","Logistica")"
                   configuracion="@Url.Action("GetConfigxUsuarioML","Logistica")"
                   updateconfiguracion="@Url.Action("InsertaConfigxUsuarioML","Logistica")"
                   ovdetails="@Url.Action("GetOrdenesVentaDetailsML","Global")"
                   class="table table-striped table-fixed">
                <thead>
                    <tr>
                        <th>Folio</th>
                        <th>Estatus Carga</th>
                        <th>Tipo Reparto</th>
                        <th>Fecha Pedido</th>
                        <th>Fecha Solicitud Producción</th>
                        <th>Cliente</th>
                        <th>Comentarios</th>
                        <th>Bitácora</th>
                    </tr>
                </thead>
                <tbody>
                    <tr style="background-color:lightgray">
                        <td style="text-align:center" colspan="8">SIN DATOS</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="row pt-5">
        <div class="col-12">
            <div class="card bg-light mb-3">
                <div class="card-header">
                    <div id="MLHeader" class="d-none bg-white rounded box-shadow">
                        <div class="card">
                            <div class="card-body ReportHeaderv2">
                                <div class="row">
                                    <div class="col-6 text-start d-flex align-items-center justify-content-start">
                                        <img src="/Images/logoFisfiber.png" alt="" class="w-50">
                                    </div>
                                    <div class="col-6 text-end">
                                        <div class="row">
                                            <div class="col-12 text-start">
                                                <div class="TitleReportContainer">
                                                    <span class="ps-2">
                                                        FECHA DE LIBERACIÓN: <span id="fecha-liberacion"></span>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-6 text-start">
                                                <div class="TitleReportContainer">
                                                    <span class="ps-2">
                                                        RC-MONITOR-01-01
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="col-6 text-start">
                                                <div class="TitleReportContainer text-right">
                                                    <span class="pe-2">
                                                        REVISION: <span id="revision"></span>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-9 text-start">
                                                <div class="TitleReportContainer">
                                                    <span class="ps-2">
                                                        FECHA DE REVISIÓN: <span id="fecha-revision"></span>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="col-3 text-start">
                                                <div class="TitleReportContainer text-right">
                                                    <span class="pe-2">
                                                        NIVEL 3
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-6 text-start">
                                                <div class="TitleReportContainer">
                                                    <span class="ps-2">
                                                        FOLIO: <span id="folio"></span>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="col-6 text-start">
                                                <div class="TitleReportContainer text-right">
                                                    <span class="pe-2">
                                                        FECHA: <span id="fecha-documento"></span>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @*<h5 id="PPHeaderTitle" class="text-center pt-2">
                            Detalle de monitor de logística <strong id="folioseleccionado"></strong>
                        </h5>*@
                </div>
                <div id="reportbyline" class="card-body pt-2">
                    <h5 class="card-title">!Ningun monitor seleccionado!</h5>
                    <p class="card-text">Aquí podrás visualizar el detalle de el monitor de logística seleccionado.</p>
                </div>
            </div>
        </div>
    </div>
    <div class="row pb-4 pt-2 pe-3">
        <div class="col-12 d-flex justify-content-end">
            <a href="#" id="actualizar" restart="false" class="d-none btn mb-2 mb-md-0 btn-outline next">Actualizar</a>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="Bitacora" tabindex="-1" aria-labelledby="Bitacora" aria-hidden="true" data-bs-backdrop="static" @*data-bs-keyboard="false"*@>
        <div class="modal-dialog modal-dialog-centered modal-lg modal100">
            <div class="modal-content">
                <div class="modal-header" style="display:block !important">
                    <h5 class="modal-title" id="HeaderTitle">Bitácora de plan de producción <strong id="folioML"></strong></h5>
                    <span>*Aqui se mostrará el historial de versiones anteriores del plan, la ultima versión se muestra en la página principal en la parte inferiór al dar click en un folio*</span>
                    @*<i role="button" class="fa-solid fa-xmark" data-bs-dismiss="modal" aria-label="Close"></i>*@
                </div>
                <form metodo="" class="pt-1 ps-3 pe-3 needs-validation" novalidate>
                    <div class="modal-body text-center">
                        <div class="row">
                            <div class="col-md-12 body-table">
                                <table id="BitacoraML" class="table table-striped table-fixed">
                                    <thead>
                                        <tr>
                                            <th width="150">Folio</th>
                                            <th>Revisión</th>
                                            <th>Descripción</th>
                                            <th width="300">Usuario</th>
                                            <th width="250">Fecha</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="background-color:lightgray">
                                            <td style="text-align:center" colspan="5">SIN DATOS</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer mt-3">
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="BitacoraDetalle" tabindex="-1" aria-labelledby="Bitacora" aria-hidden="true" data-bs-backdrop="static" @*data-bs-keyboard="false"*@>
        <div class="modal-dialog modal-dialog-centered modal-lg modal100">
            <div class="modal-content">
                <div class="modal-header" style="display:block !important">
                    <div class="d-flex justify-content-between align-items-center">
                        <div><h6 class="modal-title" id="HeaderTitle">Bitácora de plan de producción <strong id="folioRevision"></strong></h6></div>
                        <div><h6 class="modal-title"> Revisión <strong id="Revision"></strong></h6></div>
                        <div><h6 class="modal-title"> Fecha <strong id="FechaRevision"></strong></h6></div>
                    </div>
                </div>
                <form metodo="" class="pt-1 ps-3 pe-3 needs-validation" novalidate>
                    <div class="modal-body text-center">
                        <div class="row pb-2">
                            <div class="col-md-12 d-flex justify-content-end">
                                <button type="button" id="DescargarBitacora" class="btn btn-outline-secondary">Descargar Excel</button>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="row m-0 pb-4">
                                    <div class="col-md-12 p-0 body-table">
                                        <table id="BitacoraDetailsList" class="table table-striped table-bordered" style="table-layout:fixed">
                                            <thead>
                                                <tr>
                                                    <th width="240">Línea</th>
                                                    <th width="200">Comentarios Extras</th>
                                                    <th width="200">Prioridad</th>
                                                    <th width="200">Ubicación Propuesta</th>
                                                    <th width="200">Hora Propuesta</th>
                                                    <th width="200">Ubicación Final</th>
                                                    <th width="200">Rollos</th>
                                                    <th width="200">Piezas Producidas</th>
                                                    <th width="200">Pedido</th>
                                                    <th width="200">Codigo Cliente</th>
                                                    <th width="200">Solicitado</th>
                                                    <th width="200">Núm. Artículo</th>
                                                    <th width="250">Descripción Artículo</th>
                                                    <th width="200">Almacén</th>
                                                    <th width="200">Metros Rollo</th>
                                                    <th width="200">Especificación</th>
                                                    <th width="200">Hora Inicio</th>
                                                    <th width="200">Hora Final</th>
                                                    <th width="200">Tiempo Producción</th>
                                                    <th width="200">Cantidad Metros</th>
                                                    <th width="200">Comentarios</th>
                                                    <th width="200">Fecha Contabilización</th>
                                                    <th width="200">Fecha Fabricación</th>
                                                    <th width="200">Fecha Entrega</th>
                                                    <th width="200">Cliente</th>
                                                    <th width="200">Cantidad Kilos</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer mt-3">
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="ConfiguracionML" tabindex="-1" aria-labelledby="Bitacora" aria-hidden="true" data-bs-backdrop="static" @*data-bs-keyboard="false"*@>
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content-transparent">
                <div class="modal-header-transparent" style="display:block !important">

                </div>

                <div class="modal-body text-center">
                    <form metodo="" class="pt-1 ps-3 pe-3 needs-validation" novalidate>
                        <div class="row">
                            <div class="col-12">
                                <div class="container">
                                    <div class="row pt-1 m-auto">
                                        <div class="col-md-12 col-lg-12 pb-3">
                                            <div class="card card-custom bg-white border-white border-0" style="height: 550px">
                                                <div class="card-custom-img" style="background-image: url(http://res.cloudinary.com/d3/image/upload/c_scale,q_auto:good,w_1110/trianglify-v1-cs85g_cc5d2i.jpg);">
                                                    <div class="card-header text-right" style="border:none !important">
                                                        <span class="text-white font-weight-bold fs-6">* Configura las columnas visibles para el monitor de logística *</span>
                                                        <div class="pb-3 pt-2 ps-3 form-check">
                                                            <input type="checkbox" class="form-check-input anycheck" id="selectAll">
                                                            <label class="form-check-label text-white font-weight-bold" for="selectAll">Seleccionar todas</label>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-custom-avatar">
                                                    <img class="img-fluid" src="~/Images/FFISA.png" alt="Avatar">
                                                </div>
                                                <div class="card-body d-flex justify-content-start flex-column" id="configuracionMLContainer" style="overflow-y: auto">

                                                </div>
                                                <div class="card-footer" style="background: inherit; border-color: inherit;text-align:end">
                                                    <a href="#" class="btn btn-outline-secondary" id="GuardaConfigML">Guardar</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
 
</div>



<!-- Modal Plan Produccion -->
<div class="modal fade" id="PPLModal"  details="@Url.Action("GetPlanesProduccionDetails","PlanProduccion")" tabindex="-1" aria-labelledby="PPLModal" aria-hidden="true" data-bs-backdrop="static" @*data-bs-keyboard="false"*@>
    <div class="modal-dialog modal-dialog-centered modal-lg modal100">
        <div class="modal-content">
            <div class="modal-header" style="display:block !important">
                <div class="d-flex justify-content-between align-items-center">
                    <div><h6 class="modal-title" id="HeaderTitlePPL">Plan de producción : <strong id="folioPPL">P006:002</strong></h6></div>
                    @*<div><h6 class="modal-title"> Revisión <strong id="Revision"></strong></h6></div>
                    <div><h6 class="modal-title"> Fecha <strong id="FechaRevision"></strong></h6></div>*@
                </div>
            </div>
            <form metodo="" class="pt-1 ps-3 pe-3 needs-validation" novalidate>
                <div class="modal-body text-center">
                    <div id="reportbylinePP" class="card-body pt-2">
                        <h5 class="card-title">!Ningun monitor seleccionado!</h5>
                        <p class="card-text">Aquí podrás visualizar el detalle de el monitor de logística seleccionado.</p>
                    </div>
                </div>
                <div class="modal-footer mt-3">
                    <button id="ClosePPLModal" type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span class="btn mb-2 mb-md-0 btn-outline-danger ">
                            Cerrar
                        </span>
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
@*<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.16.9/xlsx.full.min.js"></script>*@
<script src="~/Scripts/Logistica/ConsultaMonitorLogistica.js?v=1.0.1"></script>
