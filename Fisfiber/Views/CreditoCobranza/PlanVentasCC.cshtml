
@{
    ViewBag.Title = "Consulta y edicion plan ventas";
}

<link rel="stylesheet" href="~/Styles/PlanProduccion/ConsultaPlanProduccion.css">
<link rel="stylesheet" href="~/Styles/PlanProduccion/PlanPro.css">

<div class="pt-2 ms-3 me-4">
    <div class="row pt-1 ps-3 pe-3 pt-4">
        <div class="col-12 text-center">
            <h5>
                Planes de ventas preliminales
            </h5>
        </div>
    </div>

    <div id="MenuContextBitacora">
        <ul>
            <li id="editPPM">
                <i class="fa-solid bi bi-pencil-square NewTableRowIcon"></i>
                Agregar Pedidos
            </li>
        </ul>
    </div>
    <div class="row">
        <div class="col-md-12 body-table">
            <table id="PlanesVentas"
                   action="@Url.Action("GetPlanesVentas","PlanVentas")"
                   details="@Url.Action("GetPlanesVentasDetailsCyC","PlanVentas")"
                   ovdetails="@Url.Action("GetOrdenesVentaDetails","Global")"
                   update="@Url.Action("UpdateEstatusOV","CreditoCobranza")"
                   modifyPP="@Url.Action("ActualizarOF","PlanProduccion")"
                   configuracion="@Url.Action("GetConfigxUsuarioPP","PlanProduccion")"
                   finalizarPlan="@Url.Action("FinalizarPlanVentas","PlanVentas")"
                   updateEstatus="@Url.Action("UpdateEstatusPlanCC","CreditoCobranza")"
                   class="table table-striped table-fixed">
                <thead>
                    <tr>
                        <th>Folio</th>
                        <th>FechaCreacion</th>
                        <th>TotalPedidos</th>
                        <th>TotalAutorizados</th>
                        <th>TotalNoAutorizados</th>
                        <th>TotalClientes</th>
                        <th>TotalArticulos</th>
                        <th>TotalConCita</th>
                        <th>TotalEntregaParcial</th>
                        <th>TotalPiezasEntrega</th>
                    </tr>
                </thead>
                <tbody>
                    <tr style="background-color:lightgray">
                        <td style="text-align:center" colspan="8">SIN DATOS</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="row pt-5">
        <div class="row pb-2 mb-3 d-none" id="ContenedorBtnExcel">

           
                <div class="col-md-6 pt-1 ps-4">
                    <h5 style="margin-bottom:0px;">ESTATUS PLAN : <label class="fw-bold px-2 py-1" style="color:white;" id="estPVCC"></label></h5>
                </div>
                <div class="col-md-6 d-flex justify-content-end">
                    <button id="CheckRevCyC"
                            class="btn btn-outline-secondary"
                            style="height: 95%;">
                        <i class="bi bi-bookmark-check me-2"></i> Autorizar Plan
                    </button>
                    <button id="DescargarCreditoCobranza"
                            class="btn btn-success ms-2"
                            style="height: 95%;">
                        <i class="fas fa-file-excel me-2"></i>Exportar a Excel
                    </button>
                </div>
        </div>
        <div class="col-12">
            <div class="card bg-light mb-3">
                <div class="card-header">


                    <div id="PPHeader" class="bg-black rounded box-shadow d-none">
                        <div class="card bg-black" style="color: white">
                            <div class="card-body ReportHeaderv2">
                                <div class="row">
                                    <div class="col-6 text-start d-flex align-items-center justify-content-start">
                                        <img src="/Images/logoFisfiber.png" alt="" class="w-50" />
                                    </div>
                                    <div class="col-6 text-end">
                                        <div class="row EditRow">
                                            <div class="col-6">
                                                <div class="input-group input-group-sm editAdmin mb-2">
                                                    <span class="input-group-text">Fecha Liberación:</span>
                                                    <input type="date" id="FL"
                                                           value="@Convert.ToDateTime(ViewBag.FechaLib).ToString("yyyy-MM-dd")"
                                                           class="form-control" style="height:34.2px" aria-label="Sizing
                example input" aria-describedby="inputGroup-sizing-sm">
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="input-group input-group-sm editAdmin mb-2">
                                                    <span class="input-group-text">Code:</span>
                                                    <input type="text"
                                                           id="Code"
                                                           value="@ViewBag.CodeIso"
                                                           class="form-control"
                                                           style="height: 34.2px"
                                                           aria-label="Sizing example input"
                                                           aria-describedby="inputGroup-sizing-sm" />
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="input-group input-group input-group-sm editAdmin mb-2">
                                                    <span class="input-group-text">Fecha Revisión:</span>
                                                    <input type="date" id="FR"
                                                           value="@Convert.ToDateTime(ViewBag.FechaRev).ToString("yyyy-MM-dd")"
                                                           class="form-control" style="height:34.2px" aria-label="Sizing
                example input" aria-describedby="inputGroup-sizing-sm">
                                                </div>
                                            </div>

                                            <div class="col-3">
                                                <div class="input-group input-group-sm editAdmin mb-2">
                                                    <span class="input-group-text">Nivel:</span>
                                                    <input type="number"
                                                           id="Nivel"
                                                           value="@ViewBag.Nivel"
                                                           class="form-control"
                                                           style="height: 34.2px"
                                                           aria-label="Sizing example input"
                                                           aria-describedby="inputGroup-sizing-sm" />
                                                </div>
                                            </div>

                                            <div class="col-3">
                                                <div class="input-group input-group-sm editAdmin mb-2">
                                                    <span class="input-group-text">Revisión:</span>
                                                    <input type="number"
                                                           id="Revision"
                                                           value="@ViewBag.Revision"
                                                           class="form-control"
                                                           style="height: 34.2px"
                                                           aria-label="Sizing example input"
                                                           aria-describedby="inputGroup-sizing-sm" />
                                                </div>
                                            </div>

                                            <div class="col-3 text-start">
                                                <button type="button" class="btn btn-primary btn-sm btnSave">
                                                    Guardar
                                                </button>
                                            </div>
                                        </div>

                                        <div class="row headRow">
                                            <div class="col-8 text-start">
                                                <div class="TitleReportContainer">
                                                    <span class="ps-2 ISO">
                                                        FECHA DE LIBERACIÓN:
                                                        <span id="fecha-liberacion">@ViewBag.FechaLib</span>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="col-4 btnEditHead">
                                                <i class="editHead bi bi-pencil-square pointer-event"></i>
                                            </div>
                                        </div>
                                        <div class="row mt-2 headRow">
                                            <div class="col-6 text-start">
                                                <div class="TitleReportContainer">
                                                    <span class="ps-2 ISO"> @ViewBag.CodeISO </span>
                                                </div>
                                            </div>
                                            <div class="col-6 text-start">
                                                <div class="TitleReportContainer text-right">
                                                    <span class="pe-2">
                                                        REVISION: <span id="">@ViewBag.Revision</span>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mt-2 headRow">
                                            <div class="col-9 text-start">
                                                <div class="TitleReportContainer">
                                                    <span class="ps-2 ISO">
                                                        FECHA DE REVISIÓN:
                                                        <span id="fecha-revisionPE">@ViewBag.FechaRev</span>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="col-3 text-start">
                                                <div class="TitleReportContainer text-right">
                                                    <span class="pe-2 ISO"> NIVEL @ViewBag.Nivel </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-6 text-start">
                                                <div class="TitleReportContainer">
                                                    <span class="ps-2"> FOLIO: <span id="folioPV"></span> </span>
                                                </div>
                                            </div>
                                            <div class="col-6 text-start">
                                                <div class="TitleReportContainer text-right">
                                                    <span class="pe-2">
                                                        FECHA: <span id="fecha-documento"></span>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h5 id="PPHeaderTitle" class="text-center">
                        Detalle de plan de ventas <strong id="folioseleccionado"></strong>
                    </h5>
                </div>

                <div id="reportbyline" class="card-body pt-2">
                    <h5 class="card-title">!Ning&uacute;n plan seleccionado!</h5>
                    <p class="card-text">Aquí podrás visualizar el detalle de el plan de producción seleccionado.</p>
                </div>
            </div>
        </div>
    </div>
    <div class="row pb-4 pt-2 pe-3">
        <div class="col-12 d-flex justify-content-end">
            <a href="#" id="actualizar" restart="false" class="d-none btn mb-2 mb-md-0 btn-outline">Actualizar</a>
        </div>
    </div>

    <!-- Modal para confirmacion de finalizacion -->
    <div class="modal fade" id="ConFinalizacion" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        ¿Quieres continuar?
                    </h5>
                </div>
                <form metodo="" class="pt-1 ps-3 pe-3 needs-validation" novalidate>
                    <div class="modal-body text-center">
                        <p class="font-weight-bold">
                            Una vez finalizado el plan, ya no será posible editarlo.
                        </p>
                    </div>
                    <div class="modal-footer mt-3">
                        <button type="button"
                                class="btn btn-outline-danger"
                                id="CancelFinalizacion">
                            Cancelar
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary"
                                id="ConfirmFinaliacion">
                            Continuar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>




</div>



<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="~/Scripts/CreditoCobranza/CreditoCobranza.js?v=1.0.2"></script>
