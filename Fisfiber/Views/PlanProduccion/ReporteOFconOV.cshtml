
@{
    ViewBag.Title = "Reporte Orden Fabricación vs Orden Venta";
}

<link rel="stylesheet" href="~/Styles/PlanProduccion/ReporteOFconOV.css" />

<div class="pt-2 ms-3 me-4">

    <div class="row d-flex justify-content-between align-items-center mb-2">
        <div class="col-md-6 text-start" style="height: 30px">
            <a id="edicionPP"
               href="#">
                <p class="edicionPP hover-effect-8 Configurarvista">
                    Configuración plan producción <i class="fa-solid fa-gear"></i>
                </p>
            </a>
        </div>

        <div class="col-md-4 text-end">
            <button type="submit" id="searchData" class="btn btn-outline-secondary BtnBuscarDates">Buscar</button>
        </div>
    </div>



    <div class="row mt-3" style="height: 100px;">


        <div class="col-md-4 col-auto mb-4">
            <h6 class="font-weight-bold">
                Orden Venta
            </h6>
            <form metodo="FiltroOV" class="needs-validation" novalidate>
                <div class="row">
                    <div class="col-11 d-flex align-items-end justify-content-between">
                        <div class="pe-3 position-relative" >
                            <label for="numOV" class="form-label LabelFecha">Núm OV</label>
                            <input type="number" class="form-control" id="numOV" pattern="[0-9]*" inputmode="numeric" aria-describedby="FIHelp">
                            <div class="invalid-feedback position-absolute">
                                Ingresa un num ov valido.
                            </div>
                        </div>
                        <div class="pe-3 position-relative" style="width:55%;">
                            <label for="estOV" class="form-label LabelFecha">Estatus OV SAP</label>
                            @*<input class="form-control CamposFecha" id="estOV">*@
                            <select id="estOV" class="form-control form-select">
                                <option value="" selected></option>
                                <option value="O">Abierta</option>
                                <option value="C">Cerrada</option>
                            </select>
                            <div class="invalid-feedback position-absolute">
                                Seleccione un estatus valido.
                            </div>
                        </div>
                        <div class="d-none">
                            <button type="submit" class="btn btn-outline-secondary BtnBuscarDates">Buscar</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>


        <div class="col-md-4 col-auto mb-4">
            <h6 class="font-weight-bold">
                Rangos de fecha orden venta
            </h6>
            <form metodo="FiltroFecha" class="needs-validation" novalidate>
                <div class="row">
                    <div class="col-6 d-flex align-items-end justify-content-start">
                        <div class="pe-3 position-relative">
                            <label for="FI" class="form-label LabelFecha">Fecha Inicio</label>
                            <input type="date" class="form-control CamposFecha" id="FI" aria-describedby="FIHelp">
                            <div class="invalid-feedback position-absolute">
                                Seleccione la fecha de inicio.
                            </div>
                        </div>
                        <div class="pe-3 position-relative">
                            <label for="FF" class="form-label LabelFecha">Fecha Fin</label>
                            <input type="date" class="form-control CamposFecha" id="FF">
                            <div class="invalid-feedback position-absolute">
                                Seleccione la fecha de fin.
                            </div>
                        </div>
                        <div class="d-none">
                            <button type="submit" class="btn btn-outline-secondary BtnBuscarDates">Buscar</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>


        <div class="col-md-4 col-auto mb-4" id="FiltroseOF">
            <h6 class="font-weight-bold">
                Orden Fabricación
            </h6>
            <form metodo="FiltroOF" class="needs-validation" novalidate>
                <div class="row">
                    <div class="col-11 d-flex align-items-end justify-content-between">
                        <div class="pe-3 position-relative">
                            <label for="numOF" class="form-label LabelFecha">Núm OF</label>
                            <input type="number" class="form-control CamposFecha" id="numOF" pattern="[0-9]*" inputmode="numeric" aria-describedby="FIHelp">
                            <div class="invalid-feedback position-absolute">
                                Ingresa un numero de OF.
                            </div>
                        </div>
                        <div class="pe-3 position-relative" style="width:55%;">
                            <label for="estOF" class="form-label LabelFecha">Estatus OF SAP</label>
                            @*<input type="date" class="form-control CamposFecha" id="estOF">*@
                            <select id="estOF" class="form-control form-select" aria-label="Default select example">
                                <option value="" selected></option>
                                <option value="P">Planificada</option>
                                <option value="R">Liberada</option>
                                <option value="L">Cerrada</option>
                                <option value="C">Cancelada</option>
                            </select>
                            <div class="invalid-feedback position-absolute">
                                Seleccione un estatus valido.
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        @*<div class="col-md-4 mb-5">
                <button type="submit" id="searchData" class="btn btn-outline-secondary BtnBuscarDates">Buscar</button>
            </div>*@



    </div>

    <div class="col-md-12 body-table">
        <table id="OV"
               urldestino="@Url.Action("GetOrdenesVentaOF","PlanProduccion")"
               configROV="@Url.Action("GetConfigxUsuarioROV","PlanProduccion")"
               insertConfigROV="@Url.Action("InsertaConfigxUsuarioROV","PlanProduccion")"
               class="table table-striped table-fixed">
            <thead>
                <tr id="headOV">
                    <th>DocEntryOV</th>
                    <th>OrdenVenta</th>
                    <th>EstatusOV</th>
                    <th>CodigoCliente</th>
                    <th>NombreCliente</th>
                    <th>FechaCreacionOV</th>
                    <th>FechaVencimientoOV</th>
                    <th>Articulo</th>
                    <th>OrdenFabricacion</th>
                    <th>EstadoOF</th>
                    <th>FechaEntregaOF</th>
                </tr>
            </thead>
            <tbody>
                <tr style="background-color:lightgray">
                    <td style="text-align:center" colspan="14">SIN DATOS</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>


<!-- Modal Configuracion Columnas -->
<div class="modal fade" id="ConfiguracionPP" tabindex="-1" aria-labelledby="Bitacora" aria-hidden="true" data-bs-backdrop="static" @*data-bs-keyboard="false"*@>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content-transparent">
            <div class="modal-header-transparent" style="display:block !important">

            </div>

            <div class="modal-body text-center">
                <form metodo="" class="pt-1 ps-3 pe-3 needs-validation" novalidate>
                    <div class="row">
                        <div class="col-12">
                            <div class="container">
                                <div class="row pt-1 m-auto">
                                    <div class="col-md-12 col-lg-12 pb-3">
                                        <div class="card card-custom bg-white border-white border-0" style="height: 550px">
                                            <div class="card-custom-img" style="background-image: url(http://res.cloudinary.com/d3/image/upload/c_scale,q_auto:good,w_1110/trianglify-v1-cs85g_cc5d2i.jpg);">
                                                <div class="card-header text-center" style="border:none !important">
                                                    <span class="text-white font-weight-bold fs-4">Configuración de columnas</span>
                                                    <div class="pb-3 pt-2 ps-3 form-check">
                                                        <input type="checkbox" class="form-check-input anycheck" id="selectAll">
                                                        <label class="form-check-label text-white font-weight-bold" for="selectAll">Seleccionar todas</label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-custom-avatar">
                                                <img class="img-fluid" src="~/Images/FFISA.png" alt="Avatar">
                                            </div>
                                            <div class="card-body d-flex justify-content-start flex-column" id="configuracionPPContainer" style="overflow-y: auto">

                                            </div>
                                            <div class="card-footer" style="background: inherit; border-color: inherit;text-align:end">
                                                <a href="#" class="btn btn-outline-secondary" id="GuardaConfigPP">Guardar</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<script src="~/Scripts/PlanProduccion/ReportesOFOV.js?v=1.0.0"></script>