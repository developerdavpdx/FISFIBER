
@{
    ViewBag.Title = "Reportes Del Plan De Producción";
}
<link rel="stylesheet" href="~/Styles/PlanProduccion/ConsultaPlanProduccion.css">
<link rel="stylesheet" href="~/Styles/PlanProduccion/PlanPro.css">

<div class="pt-2 ms-3 me-4">
    <div class="row pt-1 ps-3 pe-3 pt-4">
        <div class="col-12 text-center">
            <h5>
                Planes de producción con ordenes terminadas
            </h5>
        </div>
    </div>

    <div class="row pt-1 ps-3 pe-3 pt-4">
        <div class="col-md-6 col-auto"> 
            <h6 class="font-weight-bold">
                Lineas de producción
            </h6>
            <form metodo="FiltroLineas" class="needs-validation" novalidate>
                <div class="row">
                    <div id="NombreLineas" class="row lineas-container">
                        <div class="form-check lineas-check">
                            <input type="checkbox" class="form-check-input anycheck" id="178948">
                            <label class="form-check-label" for="178948">Check me out</label>
                        </div>
                    </div>
                </div>
            </form>
        </div>


        <div class="col-md-6 col-auto mb-3">
            <h6 class="font-weight-bold">
                Rangos de fecha
            </h6>
            <form metodo="FiltroFecha" class="needs-validation" novalidate>
                <div class="row">
                    <div class="col-6 d-flex align-items-end justify-content-start">
                        <div class="pe-3 position-relative">
                            <label for="FI" class="form-label LabelFecha">Fecha Inicio</label>
                            <input type="date" class="form-control CamposFecha" id="FI" aria-describedby="FIHelp">
                            <div class="invalid-feedback position-absolute">
                                Seleccione la fecha de inicio.
                            </div>
                        </div>
                        <div class="pe-3 position-relative">
                            <label for="FF" class="form-label LabelFecha">Fecha Fin</label>
                            <input type="date" class="form-control CamposFecha" id="FF">
                            <div class="invalid-feedback position-absolute">
                                Seleccione la fecha de fin.
                            </div>
                        </div>
                        <div>
                            <button type="submit" class="btn btn-outline-secondary BtnBuscarDates">Buscar</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="row pt-1 ps-3 pe-3 pt-4">
        <div class="col-12 text-right">
            <a id="edicionPP" href="#">
                <p class="edicionPP hover-effect-8 Configurarvista">
                    Configuración vista plan producción <i class="fa-solid fa-gear"></i>
                </p>
            </a>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 body-table">
            <table id="PlanProduccion" 
                   action="@Url.Action("GetPlanesProduccion","PlanProduccion")" 
                   details="@Url.Action("GetPlanesProduccionDetailsReportes","PlanProduccion")" 
                   bitacora="@Url.Action("GetBitacoraPP","PlanProduccion")" 
                   bitacoradetails="@Url.Action("GetBitacoraDetailsPP","PlanProduccion")" 
                   update="@Url.Action("ActualizarOF","PlanProduccion")" 
                   modifyPP="@Url.Action("ActualizarOF","PlanProduccion")" 
                   configuracion="@Url.Action("GetConfigxUsuarioPP","PlanProduccion")" 
                   updateconfiguracion="@Url.Action("InsertaConfigxUsuarioPP","PlanProduccion")" class="table table-striped table-bordered table-fixed">
                <thead>
                    <tr>
                        <th>Folio</th>
                        <th>Linea</th>
                        <th>Fecha creación</th>
                        <th>Cantidad kilos</th>
                        <th>Artículo</th>
                        <th>Descripción artículo</th>
                        <th>Generar</th>
                        <th>No. orden fabricación</th>
                        <th>Estatus</th>
                        <th>Bitácora</th>
                    </tr>
                </thead>
                <tbody>
                    <tr style="background-color:lightgray">
                        <td style="text-align:center" colspan="8">SIN DATOS</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="row pt-5">
        <div class="col-12">
            <div class="card bg-light mb-3">
                <div class="card-header">
                    <div id="PPHeader" class="d-none bg-white rounded box-shadow">
                        <div class="card">
                            <div class="card-body ReportHeaderv2">
                                <div class="row">
                                    <div class="col-6 text-start d-flex align-items-center justify-content-start">
                                        <img src="/Images/logoFisfiber.png" alt="" class="w-50">
                                    </div>
                                    <div class="col-6 text-end">
                                        <div class="row">
                                            <div class="col-12 text-start">
                                                <div class="TitleReportContainer">
                                                    <span class="ps-2">
                                                        FECHA DE LIBERACIÓN: <span id="fecha-liberacion"></span>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-6 text-start">
                                                <div class="TitleReportContainer">
                                                    <span class="ps-2">
                                                        RC-PLANEACION-01-01
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="col-6 text-start">
                                                <div class="TitleReportContainer text-right">
                                                    <span class="pe-2">
                                                        REVISION: <span id="revision"></span>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-9 text-start">
                                                <div class="TitleReportContainer">
                                                    <span class="ps-2">
                                                        FECHA DE REVISIÓN: <span id="fecha-revision"></span>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="col-3 text-start">
                                                <div class="TitleReportContainer text-right">
                                                    <span class="pe-2">
                                                        NIVEL 3
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-6 text-start">
                                                <div class="TitleReportContainer">
                                                    <span class="ps-2">
                                                        FOLIO: <span id="folio"></span>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="col-6 text-start">
                                                <div class="TitleReportContainer text-right">
                                                    <span class="pe-2">
                                                        FECHA: <span id="fecha-documento"></span>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h5 id="PPHeaderTitle" class="text-center">
                        Detalle de plan de producción <strong id="folioseleccionado"></strong>
                    </h5>
                </div>
                <div id="reportbyline" class="card-body pt-2">
                    <h5 class="card-title">!Ningún plan seleccionado!</h5>
                    <p class="card-text">Aquí podrás visualizar el detalle de el plan de producción seleccionado.</p>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="Bitacora" tabindex="-1" aria-labelledby="Bitacora" aria-hidden="true" data-bs-backdrop="static" @*data-bs-keyboard="false"*@>
        <div class="modal-dialog modal-dialog-centered modal-lg modal100">
            <div class="modal-content">
                <div class="modal-header" style="display:block !important">
                    <h5 class="modal-title" id="HeaderTitle">Bitácora de plan de producción <strong id="folioPP"></strong></h5>
                    <span>*Aqui se mostrará el historial de versiones anteriores del plan, la ultima versión se muestra en la página principal en la parte inferiór al dar click en un folio*</span>
                    @*<i role="button" class="fa-solid fa-xmark" data-bs-dismiss="modal" aria-label="Close"></i>*@
                </div>
                <form metodo="" class="pt-1 ps-3 pe-3 needs-validation" novalidate>
                    <div class="modal-body text-center">
                        <div class="row">
                            <div class="col-md-12 body-table">
                                <table id="BitacoraPP" class="table table-striped table-bordered table-fixed">
                                    <thead>
                                        <tr>
                                            <th width="150">Folio</th>
                                            <th>Revisión</th>
                                            <th>Descripción</th>
                                            <th width="300">Usuario</th>
                                            <th width="250">Fecha</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="background-color:lightgray">
                                            <td style="text-align:center" colspan="5">SIN DATOS</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer mt-3">
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="BitacoraDetalle" tabindex="-1" aria-labelledby="Bitacora" aria-hidden="true" data-bs-backdrop="static" @*data-bs-keyboard="false"*@>
        <div class="modal-dialog modal-dialog-centered modal-lg modal100">
            <div class="modal-content">
                <div class="modal-header" style="display:block !important">
                    <div class="d-flex justify-content-between align-items-center">
                        <div><h6 class="modal-title" id="HeaderTitle">Bitácora de plan de producción <strong id="folioRevision"></strong></h6></div>
                        <div><h6 class="modal-title"> Revisión <strong id="Revision"></strong></h6></div>
                        <div><h6 class="modal-title"> Fecha <strong id="FechaRevision"></strong></h6></div>
                    </div>
                </div>
                <form metodo="" class="pt-1 ps-3 pe-3 needs-validation" novalidate>
                    <div class="modal-body text-center">
                        <div class="row pb-2">
                            <div class="col-md-12 d-flex justify-content-end">
                                <button type="button" id="DescargarBitacora" class="btn btn-outline-secondary">Descargar Excel</button>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="row m-0 pb-4">
                                    <div class="col-md-12 p-0 body-table">
                                        <table id="BitacoraDetailsList" class="table table-striped table-bordered" style="table-layout:fixed">
                                            <thead>
                                                <tr>
                                                    <th width="240">Línea</th>
                                                    <th width="200">Comentarios Extras</th>
                                                    <th width="200">Prioridad</th>
                                                    <th width="200">Ubicación Propuesta</th>
                                                    <th width="200">Hora Propuesta</th>
                                                    <th width="200">Ubicación Final</th>
                                                    <th width="200">Rollos</th>
                                                    <th width="200">Piezas Producidas</th>
                                                    <th width="200">Pedido</th>
                                                    <th width="200">Codigo Cliente</th>
                                                    <th width="200">Solicitado</th>
                                                    <th width="200">Núm. Artículo</th>
                                                    <th width="250">Descripción Artículo</th>
                                                    <th width="200">Almacén</th>
                                                    <th width="200">Metros Rollo</th>
                                                    <th width="200">Especificación</th>
                                                    <th width="200">Hora Inicio</th>
                                                    <th width="200">Hora Final</th>
                                                    <th width="200">Tiempo Producción</th>
                                                    <th width="200">Cantidad Metros</th>
                                                    <th width="200">Comentarios</th>
                                                    <th width="200">Fecha Contabilización</th>
                                                    <th width="200">Fecha Fabricación</th>
                                                    <th width="200">Fecha Entrega</th>
                                                    <th width="200">Cliente</th>
                                                    <th width="200">Cantidad Kilos</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer mt-3">
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="ConfiguracionPP" tabindex="-1" aria-labelledby="Bitacora" aria-hidden="true" data-bs-backdrop="static" @*data-bs-keyboard="false"*@>
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content-transparent">
                <div class="modal-header-transparent" style="display:block !important">

                </div>

                <div class="modal-body text-center">
                    <form metodo="" class="pt-1 ps-3 pe-3 needs-validation" novalidate>
                        <div class="row">
                            <div class="col-12">
                                <div class="container">
                                    <div class="row pt-1 m-auto">
                                        <div class="col-md-12 col-lg-12 pb-3">
                                            <div class="card card-custom bg-white border-white border-0" style="height: 550px">
                                                <div class="card-custom-img" style="background-image: url(http://res.cloudinary.com/d3/image/upload/c_scale,q_auto:good,w_1110/trianglify-v1-cs85g_cc5d2i.jpg);">
                                                    <div class="card-header text-center" style="border:none !important">
                                                        <span class="text-white font-weight-bold fs-4">Configuración de columnas</span>
                                                        <div class="pb-3 pt-2 ps-3 form-check">
                                                            <input type="checkbox" class="form-check-input anycheck" id="selectAll">
                                                            <label class="form-check-label text-white font-weight-bold" for="selectAll">Seleccionar todas</label>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-custom-avatar">
                                                    <img class="img-fluid" src="~/Images/FFISA.png" alt="Avatar">
                                                </div>
                                                <div class="card-body d-flex justify-content-start flex-column" id="configuracionPPContainer" style="overflow-y: auto">

                                                </div>
                                                <div class="card-footer" style="background: inherit; border-color: inherit;text-align:end">
                                                    <a href="#" class="btn btn-outline-secondary" id="GuardaConfigPP">Guardar</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="EdicionOrdenes" tabindex="-1" aria-labelledby="Bitacora" aria-hidden="true" data-bs-backdrop="static" @*data-bs-keyboard="false"*@>
        <div class="modal-dialog modal-dialog-centered modal-xl modal100">
            <div class="modal-content">
                <div class="modal-header" style="display:block !important">
                    <h5 class="modal-title">Edicion de plan de producción <span id="folioedicionPP"></span><strong></strong></h5>
                </div>
                <div class="modal-body text-center">

                    <!--END BARRA DE FLECHAS-->
                    <!--CONTENEDOR PRINCIPAL -->
                    <div class="pt-3">
                        <div class="row ps-3 pe-3">
                            <div class="col-12">
                                <!--BARRA DE FLECHAS (PASOS)-->
                                <div class="wrapper position-relative pt-3">
                                    <div class="arrow-steps clearfix w-100">
                                        <div class="step current"> <span> Ordenes de ventas</span> </div>
                                        <div class="step"> <span>Asignación Linea</span> </div>
                                        <div class="step"> <span>Asignar Prioridad</span> </div>
                                        <div class="step"> <span>Vista Previa</span> </div>
                                        <div class="step"> <span>Plan Actualizado</span> </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!--PASO 1 Ordenes Ventas-->
                        <div id="step-1" class="step-content">
                            <div class="row pt-1 ps-3 pe-3 pt-4">
                                <div class="col-12 text-center">
                                    <h5>
                                        Ordenes de venta nuevas
                                    </h5>
                                </div>
                            </div>
                            <div class="row pt-1 ps-3 pe-3 pt-4">
                                <div class="col-12">
                                    <div class="row">
                                        <div class="col-md-6 col-auto mb-3">
                                            <h6 class="font-weight-bold text-left">
                                                Rangos de fecha
                                            </h6>
                                            <form metodo="FiltroFecha" class="needs-validation" novalidate>
                                                <div class="row">
                                                    <div class="col-6 d-flex align-items-end justify-content-start">
                                                        <div class="pe-3 position-relative">
                                                            <label for="FI" class="form-label">Fecha Inicio</label>
                                                            <input type="date" class="form-control" id="FI" aria-describedby="FIHelp">
                                                            <div class="invalid-feedback position-absolute">
                                                                Seleccione la fecha de inicio.
                                                            </div>
                                                        </div>
                                                        <div class="pe-3 position-relative">
                                                            <label for="FF" class="form-label">Fecha Fin</label>
                                                            <input type="date" class="form-control" id="FF">
                                                            <div class="invalid-feedback position-absolute">
                                                                Seleccione la fecha de fin.
                                                            </div>
                                                        </div>
                                                        <div>
                                                            <button type="submit" class="btn btn-outline-secondary">Buscar</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                        <div class="col-md-6 col-auto">
                                            <h6 class="font-weight-bold text-left">
                                                Series de numeración
                                            </h6>
                                            <form metodo="FiltroSeriesNum" class="needs-validation" novalidate>
                                                <div class="row">
                                                    <div id="SerNumC" class="col-12 series-container">
                                                        <div class="form-check series-check">
                                                            <input type="checkbox" class="form-check-input anycheck" id="178948">
                                                            <label class="form-check-label" for="178948">Check me out</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row pt-1 ps-3 pe-3 pt-4">
                                <div class="col-md-12 text-left">
                                    <h6 class="font-weight-bold">
                                        Selección múltiple
                                    </h6>
                                    <div class="mb-3 form-check">
                                        <input type="checkbox" class="form-check-input anycheck" id="selectAll">
                                        <label class="form-check-label" for="selectAll">Seleccionar todas</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12 body-table p-0">
                                <table id="OV" urldestino="@Url.Action("GetOrdenesVenta","PlanProduccion")" ovdetails="@Url.Action("GetOrdenesVentaDetails","Global")" generateOF="@Url.Action("GenerarOF","PlanProduccion")" ModifyOF="@Url.Action("ModifyOF","PlanProduccion")" getitemsbyov="@Url.Action("GetItemsByOV","PlanProduccion")" checktimeov="@Url.Action("CheckTimeOV","PlanProduccion")" class="table table-striped table-bordered table-fixed">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>DocEntry</th>
                                            <th>Series</th>
                                            <th>No. de documento</th>
                                            <th>Cliente</th>
                                            <th>Num. Cliente</th>
                                            <th>Num Artículo</th>
                                            <th>Descripción Artículo</th>
                                            <th>Almacén</th>
                                            <th>No. Rollos</th>
                                            <th>Línea</th>
                                            <th>Cantidad en Metros</th>
                                            <th>Fecha de contabilización</th>
                                            <th>Fecha de fabricación</th>
                                            <th>Fecha de entrega</th>
                                            <th>Comentarios</th>
                                            <th>Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="background-color:lightgray">
                                            <td style="text-align:center" colspan="14">SIN DATOS</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!--END PASO 1 Ordenes Ventas-->
                        <!-- Contenido del PASO 2: Asignación Linea -->
                        <div id="step-2" class="step-content">
                            <div class="row ps-3 pe-3 pt-4">
                                <div class="col-12 text-center">
                                    <h5>
                                        Asignación de línea
                                    </h5>
                                </div>
                            </div>
                            <div class="col-md-12 body-table">
                                <table id="OVSelected" class="table table-striped table-bordered" style="table-layout:fixed">
                                    <thead>
                                        <tr>
                                            <th width="240">Línea</th> @*1*@
                                            <th class="d-none alwayshidden" width="200">DocEntry</th> @*0*@
                                            <th class="d-none" width="200">Comentarios Extras</th> @*0*@
                                            <th class="d-none" width="200">Ubicación Propuesta</th> @*0*@
                                            <th class="d-none" width="200">Hora propuesta</th> @*0*@
                                            <th class="d-none" width="200">Ubicación Final</th> @*0*@
                                            <th width="200">Rollos</th> @*2*@
                                            <th width="200">Piezas Producidas</th> @*3*@
                                            <th width="200">Pedido</th> @*4*@
                                            <th width="200">Codigo Cliente</th> @*5*@
                                            <th width="200">Solicitado</th> @*6*@
                                            <th width="200">Núm. Artículo</th> @*7*@
                                            <th width="280">Descripción Artículo</th> @*8*@
                                            <th width="200">Almacén</th>
                                            @*9*@
                                            <th width="200">Metros Rollo</th> @*10*@
                                            <th width="200">Especificación</th> @*11*@
                                            <th width="200">Hora Inicio</th> @*12*@
                                            <th width="200">Hora Final</th> @*13*@
                                            <th width="200">Tiempo Producción</th> @*43*@
                                            <th width="200">Cantidad Metros</th> @*15*@
                                            <th width="200">Comentarios</th> @*16*@
                                            <th width="200">Fecha Contabilización</th> @*17*@
                                            <th width="200">Fecha Fabricación</th> @*18*@
                                            <th width="200">Fecha Entrega</th> @*19*@
                                            <th width="200">Cliente</th> @*20*@
                                            <th width="200">Cantidad Kilos</th> @*21*@
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="background-color:lightgray">
                                            <td style="text-align:center" colspan="21">SIN DATOS</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- Contenido del paso 3: Asignación Prioridad y Comentarios -->
                        <div id="step-3" class="step-content">
                            <div class="row ps-3 pe-3 pt-4">
                                <div class="col-12 text-center">
                                    <h5>
                                        Asignación de prioridad y comentarios
                                    </h5>
                                </div>
                            </div>
                            <div id="OVPrioridad" class="col-md-12 body-table">

                            </div>
                            <div id="MenuPrioridadComentarios">
                                <ul>
                                    <li id="option1">
                                        <i class="bi bi-database-fill-add NewTableRowIcon"></i>
                                        Nuevo registro en blanco
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <!-- Contenido del paso 4: Preview Plan Produccion -->
                        <div id="step-4" class="step-content text-center">
                            <div class="row ps-3 pe-3 pt-4">
                                <div class="col-12 text-center">
                                    <h5>
                                        Vista Previa Plan Producción
                                    </h5>
                                </div>
                            </div>
                            <div id="PreviewOFabricacion" class="col-md-12">
                                <div class="p-3 bg-white rounded box-shadow">
                                    <div class="card">
                                        <div class="card-body ReportHeaderv2">
                                            <div class="row">
                                                <div class="col-6 text-start d-flex align-items-center justify-content-start">
                                                    <img src="~/Images/logoFisfiber.png" alt="" class="w-50">
                                                </div>
                                                <div class="col-6 text-end">
                                                    <div class="row">
                                                        <div class="col-12 text-start">
